<%- include('partials/header', { title: 'Edit Profile', user: user }) %>

<div class="container" style="padding-top: 3rem; padding-bottom: 3rem; max-width: 560px;">
  <h1 class="display-6 mb-4">Edit profile</h1>
  <div class="card">
    <div class="card-body p-4">
      <% if (error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <% if (success) { %>
      <div class="alert alert-success" role="alert"><%= success %></div>
      <% } %>
      <form
        action="/user/edit"
        method="POST"
        enctype="multipart/form-data"
        onsubmit="return validateForm()"
      >
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            type="text"
            class="form-control"
            name="username"
            id="username"
            value="<%= user.username %>"
            required
          />
        </div>
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            class="form-control"
            name="email"
            id="email"
            value="<%= user.email %>"
            required
          />
        </div>
        <div class="mb-3">
          <label for="bio" class="form-label">Bio</label>
          <textarea class="form-control" name="bio" id="bio" rows="3"><%= user.bio %></textarea>
        </div>
        <div class="mb-4">
          <label for="profilePicture" class="form-label">Profile picture</label>
          <input
            class="form-control"
            type="file"
            name="profilePicture"
            id="profilePicture"
            onchange="previewImage()"
          />
          <div class="mt-3">
            <% if (user.profilePicture && user.profilePicture.url) { %>
            <img
              src="<%= user.profilePicture.url %>"
              alt="Profile Picture"
              class="rounded-circle"
              id="currentProfilePicture"
              style="width: 90px; height: 90px; object-fit: cover; border: 1px solid var(--line);"
            />
            <% } %>
            <img
              id="image-preview"
              class="rounded-circle mt-2"
              style="width: 90px; height: 90px; object-fit: cover; display: none; border: 1px solid var(--line);"
            />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </form>
    </div>
  </div>
</div>

<script>
  function previewImage() {
    const preview = document.getElementById("image-preview");
    const file = document.getElementById("profilePicture").files[0];
    const currentImage = document.getElementById("currentProfilePicture");

    if (file) {
      preview.src = URL.createObjectURL(file);
      preview.style.display = "block";
      if (currentImage) {
        currentImage.style.display = "none";
      }
    } else {
      preview.style.display = "none";
      if (currentImage) {
        currentImage.style.display = "block";
      }
    }
  }

  function validateForm() {
    const username = document.getElementById("username").value;
    const email = document.getElementById("email").value;
    if (!username || !email) {
      alert("Username and Email are required.");
      return false;
    }
    return true;
  }
</script>

<%- include('partials/footer') %>
