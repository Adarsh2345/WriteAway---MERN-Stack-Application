<%- include('partials/header', { title, user: user }) %>

<div class="container" style="padding-top: 3rem;">
  <div class="row justify-content-center text-center mb-5">
    <div class="col-lg-7">
      <% if (success) { %>
      <div class="alert alert-success" role="alert"><%= success %></div>
      <% } %>
      <h1 class="display-5 mb-3">All posts</h1>
      <p class="text-muted mb-4"><%= totalCount %> published so far</p>

      <!-- Search box: plain GET form so results are a shareable/bookmarkable URL -->
      <form method="GET" action="/posts" class="d-flex gap-2 mb-3">
        <input
          type="text"
          name="q"
          class="form-control"
          placeholder="Search by title or content…"
          value="<%= q %>"
        />
        <!-- Preserve the active tag filter when searching -->
        <input type="hidden" name="tag" value="<%= tag %>" />
        <button type="submit" class="btn btn-primary">Search</button>
        <% if (q || tag) { %>
        <a href="/posts" class="btn btn-outline-light">Clear</a>
        <% } %>
      </form>

      <!-- Tag chips -->
      <% if (allTags.length > 0) { %>
      <div>
        <% allTags.forEach(t => { %>
        <a
          href="/posts?tag=<%= t %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
          class="tag-chip <%= tag === t ? 'active' : '' %>"
        ><%= t %></a>
        <% }) %>
      </div>
      <% } %>
    </div>
  </div>

  <div class="row">
    <% if (posts.length > 0) { %> <% posts.forEach(post => { %>
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <% if (post.images && post.images.length > 0) { %>
        <img
          src="<%= post.images[0].url %>"
          class="card-img-top"
          alt="Post Image"
          style="height: 190px; object-fit: cover; border-bottom: 1px solid var(--line);"
        />
        <% } %>
        <div class="card-body d-flex flex-column">
          <h2 class="card-title h5"><%= post.title %></h2>
          <p class="text-muted mb-2">
            by <%= post.author.username %> · <%= post.createdAt.toDateString() %>
          </p>
          <% if (post.tags && post.tags.length > 0) { %>
          <p class="mb-3">
            <% post.tags.forEach(t => { %>
            <a href="/posts?tag=<%= t %>" class="tag-chip"><%= t %></a>
            <% }) %>
          </p>
          <% } %>
          <a href="/posts/<%= post._id %>" class="btn btn-outline-light mt-auto align-self-start">Read post &rarr;</a>
        </div>
      </div>
    </div>
    <% }) %> <% } else { %>
    <div class="col-12 text-center py-5">
      <p class="text-muted">No posts found.</p>
    </div>
    <% } %>
  </div>

  <!-- Pagination, preserving the active search/tag filter -->
  <% if (totalPages > 1) { %>
  <nav aria-label="Posts pagination" class="mt-3">
    <ul class="pagination justify-content-center">
      <% for (let p = 1; p <= totalPages; p++) { %>
      <li class="page-item <%= p === currentPage ? 'active' : '' %>">
        <a
          class="page-link"
          href="/posts?page=<%= p %><%= q ? '&q=' + encodeURIComponent(q) : '' %><%= tag ? '&tag=' + encodeURIComponent(tag) : '' %>"
        ><%= p %></a>
      </li>
      <% } %>
    </ul>
  </nav>
  <% } %>
</div>

<%- include('partials/footer') %>
