<%- include('partials/header', { title: 'Home', user: user }) %>

<div class="container">
  <!-- Hero -->
  <div class="row justify-content-center text-center" style="padding: 6rem 0 4rem;">
    <div class="col-lg-8">
      <p class="text-uppercase mb-3" style="font-family: var(--font-ui); font-size: 0.8rem; letter-spacing: 0.12em; color: var(--accent);">
        A place for long-form thinking
      </p>
      <h1 class="display-4 mb-4" style="line-height: 1.1;">
        Write it down.<br />Make it count.
      </h1>
      <p class="lead mb-5" style="font-family: var(--font-body); color: var(--ink-soft); max-width: 34rem; margin-left: auto; margin-right: auto;">
        WriteAway is a simple home for your essays, notes, and ideas — with rich
        formatting, tags, and search, and nothing else getting in the way.
      </p>

      <% if (user) { %>
      <p class="mb-4" style="font-family: var(--font-ui); color: var(--ink-faint);">
        Welcome back, <strong style="color: var(--ink);"><%= user.username %></strong>.
      </p>
      <a class="btn btn-primary btn-lg me-2" href="/posts/add">Start writing</a>
      <a class="btn btn-outline-light btn-lg" href="/user/profile">Your profile</a>
      <% } else { %>
      <a class="btn btn-primary btn-lg me-2" href="/auth/register">Get started</a>
      <a class="btn btn-outline-light btn-lg" href="/posts">Browse posts</a>
      <% } %>
    </div>
  </div>

  <hr style="border-color: var(--line); margin: 0 0 4rem;" />

  <!-- What it does -->
  <div class="row g-5 mb-5">
    <div class="col-md-4">
      <h3 class="h5 mb-2">Write freely</h3>
      <p class="text-muted" style="font-size: 0.95rem;">
        A rich-text editor for formatting, images, and structure — without
        getting in the way of the words themselves.
      </p>
    </div>
    <div class="col-md-4">
      <h3 class="h5 mb-2">Get found</h3>
      <p class="text-muted" style="font-size: 0.95rem;">
        Tag your posts and let full-text search do the rest, so nothing you
        write gets lost in the archive.
      </p>
    </div>
    <div class="col-md-4">
      <h3 class="h5 mb-2">Talk it through</h3>
      <p class="text-muted" style="font-size: 0.95rem;">
        Readers can comment on what you publish — only you can edit or remove
        your own posts and comments.
      </p>
    </div>
  </div>

  <hr style="border-color: var(--line); margin: 0 0 3rem;" />

  <!-- CTA -->
  <div class="row justify-content-center text-center mb-5">
    <div class="col-lg-6">
      <h2 class="h3 mb-3">Ready to publish your first post?</h2>
      <% if (user) { %>
      <a href="/posts/add" class="btn btn-primary btn-lg">Create a post</a>
      <% } else { %>
      <a href="/auth/register" class="btn btn-primary btn-lg">Join WriteAway</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
