<%- include('partials/header', { title: 'Edit Comment', user: user }) %>

<div class="container" style="padding-top: 4rem; max-width: 500px;">
  <h1 class="h3 mb-4">Edit comment</h1>
  <div class="card">
    <div class="card-body p-4">
      <% if (error) { %>
      <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>
      <form action="/comments/<%= comment._id %>?_method=PUT" method="POST">
        <div class="mb-3">
          <textarea
            name="content"
            rows="4"
            class="form-control"
            required
          ><%= comment.content %></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
