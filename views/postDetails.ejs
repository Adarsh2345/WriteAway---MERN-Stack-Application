<%- include('partials/header', { title: post.title, user: user }) %>

<article class="container" style="padding-top: 3rem; max-width: 780px;">
  <header class="mb-4">
    <% if (post.tags && post.tags.length > 0) { %>
    <p class="mb-3">
      <% post.tags.forEach(t => { %>
      <a href="/posts?tag=<%= t %>" class="tag-chip"><%= t %></a>
      <% }) %>
    </p>
    <% } %>
    <h1 class="display-5 mb-3"><%= post.title %></h1>
    <p class="text-muted">
      by <strong style="color: var(--ink-soft);"><%= post.author.username %></strong>
      · <%= post.createdAt.toDateString() %>
    </p>
  </header>

  <% if (post.images && post.images.length > 0) { %>
  <div class="mb-4">
    <img
      src="<%= post.images[0].url %>"
      alt="Post Image"
      class="img-fluid"
      style="width: 100%; border-radius: 4px;"
    />
  </div>
  <% } %>

  <!-- Content is Quill-generated HTML, sanitized server-side before being
       passed here as `sanitizedContent` — rendered unescaped (<%- %>) so
       formatting (bold, headings, lists, etc.) actually displays. -->
  <div class="post-content mb-4"><%- sanitizedContent %></div>

  <% if (post.images && post.images.length > 1) { %>
  <div class="row mb-4">
    <% post.images.slice(1).forEach(image => { %>
    <div class="col-md-6 mb-3">
      <img src="<%= image.url %>" alt="Post Image" class="img-fluid" style="border-radius: 4px;" />
    </div>
    <% }) %>
  </div>
  <% } %>

  <% if (user && user._id.toString() === post.author._id.toString()) { %>
  <div class="d-flex gap-2 mb-5" style="border-top: 1px solid var(--line); padding-top: 1.5rem;">
    <a href="/posts/<%= post._id %>/edit" class="btn btn-outline-light">Edit post</a>
    <form action="/posts/<%= post._id %>?_method=DELETE" method="POST">
      <button type="submit" class="btn btn-danger">Delete post</button>
    </form>
  </div>
  <% } %>

  <hr style="border-color: var(--line); margin: 2rem 0;" />

  <section>
    <h2 class="h4 mb-4">
      Comments <span class="text-muted">(<%= post.comments.length %>)</span>
    </h2>

    <% if (post.comments.length > 0) { %>
    <ul class="list-unstyled">
      <% post.comments.forEach(comment => { %>
      <li class="mb-3 pb-3" style="border-bottom: 1px solid var(--line);">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <strong style="font-family: var(--font-ui); font-size: 0.9rem;"><%= comment.author.username %></strong>
            <p class="mb-0 mt-1"><%= comment.content %></p>
          </div>
          <% if (user && user._id.toString() === comment.author._id.toString()) { %>
          <div class="d-flex gap-2 flex-shrink-0 ms-3">
            <a href="/comments/<%= comment._id %>/edit" class="btn btn-sm btn-secondary">Edit</a>
            <form action="/comments/<%= comment._id %>?_method=DELETE" method="POST">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
          <% } %>
        </div>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <p class="text-muted">No comments yet.</p>
    <% } %>

    <% if (user) { %>
    <form action="/posts/<%= post._id %>/comments" method="POST" class="mt-4">
      <div class="mb-3">
        <textarea
          name="content"
          rows="3"
          class="form-control"
          placeholder="Add a comment…"
          required
        ></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Add comment</button>
    </form>
    <% } else { %>
    <p class="text-muted"><a href="/auth/login">Log in</a> to add a comment.</p>
    <% } %>
  </section>
</article>

<%- include('partials/footer') %>
