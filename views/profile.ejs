<%- include('partials/header', { title: 'Profile', user: user }) %>

<div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
  <div class="row">
    <div class="col-lg-4 mb-4">
      <div class="card">
        <div class="card-body text-center p-4">
          <% if (user.profilePicture && user.profilePicture.url) { %>
          <img
            src="<%= user.profilePicture.url %>"
            class="rounded-circle mb-3"
            style="width: 120px; height: 120px; object-fit: cover; border: 1px solid var(--line);"
            alt="Profile Picture"
          />
          <% } else { %>
          <div
            class="rounded-circle mb-3 mx-auto d-flex align-items-center justify-content-center"
            style="width: 120px; height: 120px; background-color: var(--accent-tint); font-family: var(--font-display); font-size: 2.5rem; color: var(--accent);"
          ><%= user.username.charAt(0).toUpperCase() %></div>
          <% } %>
          <h1 class="h4 mb-1"><%= user.username %></h1>
          <p class="text-muted mb-3"><%= user.email %></p>
          <% if (user.bio) { %>
          <p class="mb-3" style="font-family: var(--font-body);"><%= user.bio %></p>
          <% } %>
          <p class="text-muted mb-4">
            Joined <%= user.createdAt.toDateString() %> · <%= postCount %> post<%= postCount === 1 ? '' : 's' %>
          </p>
          <a href="/user/edit" class="btn btn-outline-light w-100 mb-2">Edit profile</a>
          <form action="/user/delete" method="POST">
            <button type="submit" class="btn btn-danger w-100">Delete account</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <h2 class="h5 mb-3 text-muted" style="font-family: var(--font-ui); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.85rem;">
        Your posts
      </h2>
      <div class="row">
        <% if (posts.length > 0) { %> <% posts.forEach(post => { %>
        <div class="col-md-6 mb-4">
          <div class="card h-100">
            <% if (post.images && post.images.length > 0) { %>
            <img
              src="<%= post.images[0].url %>"
              class="card-img-top"
              alt="Post Image"
              style="height: 160px; object-fit: cover; border-bottom: 1px solid var(--line);"
            />
            <% } %>
            <div class="card-body">
              <h3 class="h6 card-title"><%= post.title %></h3>
              <p class="text-muted mb-2"><%= post.createdAt.toDateString() %></p>
              <a href="/posts/<%= post._id %>" class="btn btn-outline-light">Read post &rarr;</a>
            </div>
          </div>
        </div>
        <% }) %> <% } else { %>
        <div class="col-12">
          <p class="text-muted">You haven't published anything yet.</p>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
