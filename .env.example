# MongoDB Atlas connection string (or any MongoDB URI). Include a database name in the path,
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/writeaway?retryWrites=true&w=majority
MONGODB_URL=

# Cloudinary credentials, used for storing uploaded post images and profile pictures.
# Find these in your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: "production" enables stricter error messages shown to users. Leave unset for local dev.
NODE_ENV=

# Optional: port the server listens on (defaults to 3000).
PORT=
